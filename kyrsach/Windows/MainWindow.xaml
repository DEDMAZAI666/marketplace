<Window x:Class="kyrsach.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kyrsach"
        xmlns:pages="clr-namespace:kyrsach.Pages"
        mc:Ignorable="d"
        Height="800" Width="1400"
        MinWidth="1100"
        MinHeight="700"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Bahnschrift"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#0078D7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" 
                                           Foreground="#999999" FontSize="14" 
                                           VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#333333" BorderThickness="1" Background="#F5F5F5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="MANGO" FontSize="24" FontWeight="Bold" Foreground="Black"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="+ Добавить товар" 
                            Background="#0078D7" Foreground="White" BorderThickness="0"
                            Padding="15,8" FontWeight="SemiBold" Cursor="Hand"
                            VerticalAlignment="Center" Margin="10,0,0,0"
                            Click="AddProduct_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#005A9E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="20,0" HorizontalAlignment="Center" Width="400">
                        <TextBox x:Name="SearchTextBox" 
                                 Style="{StaticResource SearchTextBoxStyle}" 
                                 TextChanged="SearchTextBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" 
                                   Text="Поиск товаров..." 
                                   Foreground="#999999" 
                                   FontSize="14"
                                   Margin="35,0,0,0"
                                   VerticalAlignment="Center" 
                                   IsHitTestVisible="False"
                                   Visibility="Visible"/>
                    </Grid>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">

                        <Button x:Name="AdminModerationButton" Style="{StaticResource MenuButtonStyle}" Padding="10,5" Click="ShowModeration_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Модерация" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="Log" Style="{StaticResource MenuButtonStyle}" Padding="10,5" Click="Login_Click" Visibility="Visible">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Text2" Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,5,0" Visibility="Visible"/>
                                <TextBlock x:Name="Text1" Text="Войти" FontSize="12" VerticalAlignment="Center" Visibility="Visible"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Padding="10,5" Click="ShowFavorites_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Избранное" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Padding="10,5" Click="ShowHistory_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Заказы" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Padding="10,5" Click="ShowMyProducts_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,5,0"/>
                                <TextBlock Text="Мои товары" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuButtonStyle}" Padding="10,5" Click="ShowCart_Click">
                            <StackPanel Orientation="Horizontal">
                                <Grid Margin="0,0,5,0">
                                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                                    <Border x:Name="CartBadge" Background="#E81123" CornerRadius="8" MinWidth="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,-6,-8,0" Visibility="Collapsed">
                                        <TextBlock x:Name="CartBadgeText" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Корзина" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="&#xE921;" Style="{StaticResource WindowButtonStyle}" Click="MinimizeButton_Click"/>
                        <Button Content="&#xE922;" Style="{StaticResource WindowButtonStyle}" Click="MaximizeButton_Click"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,10,0,0">
                            <TextBlock Text="Фильтры" FontSize="16" FontWeight="SemiBold" Margin="20,10,0,10"/>
                            <Button Content="Электроника" Style="{StaticResource MenuButtonStyle}" Click="Электроника"/>
                            <Button Content="Одежда" Style="{StaticResource MenuButtonStyle}" Click="Одежда"/>
                            <Button Content="Дом и сад" Style="{StaticResource MenuButtonStyle}" Click="Дом"/>
                            <Button Content="Детские товары" Style="{StaticResource MenuButtonStyle}" Click="Детские"/>
                            <Button Content="Игры и консоли" Style="{StaticResource MenuButtonStyle}" Click="Игры"/>
                            <Button Content="Автотовары" Style="{StaticResource MenuButtonStyle}" Click="Авто"/>
                            <Separator Margin="10,10" Background="#EEEEEE"/>

                            <TextBlock Text="Цена" FontSize="14" FontWeight="SemiBold" Margin="20,10,0,5"/>
                            <Slider x:Name="PriceSlider" Margin="20,0,20,0" Minimum="0" Maximum="100000" Value="100000" ValueChanged="Slider_ValueChanged"/>

                            <Button Content="Сбросить фильтры" Style="{StaticResource MenuButtonStyle}" Click="ResetFilters_Click" Margin="10,15,10,0" HorizontalAlignment="Center" Foreground="#0078D7"/>
                        </StackPanel>

                        <!-- БЛОК ПРОФИЛЯ -->
                        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="15,15" Visibility="Collapsed" x:Name="ProfilePanel">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" CornerRadius="20" Background="#E3F2FD" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#0078D7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ProfilePhone" Text="+7 (___) ___-__-__" FontSize="14" FontWeight="Bold" Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ProfileRole" Text="Покупатель" FontSize="12" Foreground="#0078D7" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <Button x:Name="LogoutButton" Grid.Column="2" Content="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#999999" Background="Transparent" BorderThickness="0" Width="28" Height="28" Cursor="Hand" ToolTip="Выйти" Click="Logout_Click" Visibility="Collapsed">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#E81123"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Separator Margin="0,0,0,10" Background="#E0E0E0"/>

                                <StackPanel Margin="0,0,0,5">
                                    <TextBlock Text="📍 Адрес доставки:" FontSize="11" Foreground="#888888"/>
                                    <TextBlock x:Name="ProfileAddress" Text="Не указан" FontSize="12" Foreground="#333333" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Text="📅 Дата регистрации:" FontSize="11" Foreground="#888888"/>
                                    <TextBlock x:Name="ProfileRegDate" Text="—" FontSize="12" Foreground="#333333" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="#FAFAFA"/>
            </Grid>
        </Grid>
    </Border>
</Window>