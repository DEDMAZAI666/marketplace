<Window x:Class="kyrsach.Windows.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kyrsach"
        mc:Ignorable="d"
        FontFamily="Bahnschrift"
        WindowStartupLocation="CenterScreen"
        Background="WhiteSmoke"
        Title="Вход и регистрация" Height="550" Width="500">
    <Grid>
        <StackPanel x:Name="MainPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <Image Source="/Images/logo.png" Width="200" Margin="0 0 0 -55"/>
            <TextBlock x:Name="TitleText" Text="Авторизация" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин или телефон" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="LoginTextBox" Height="30" Padding="5" Margin="0,0,0,15"/>

            <!-- Поля, которые видны только при регистрации -->
            <StackPanel x:Name="RegisterPanel" Visibility="Collapsed">
                <TextBlock Text="Телефон" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="PhoneTextBox" Height="30" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Адрес" FontSize="12" Margin="0,0,0,5"/>
                <TextBox x:Name="AddressTextBox" Height="30" Padding="5" Margin="0,0,0,15"/>
            </StackPanel>

            <TextBlock Text="Пароль" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordTextBox" Height="30" Padding="5" Margin="0,0,0,20"/>

            <!-- Кнопка Войти -->
            <Button x:Name="LoginBtn" Content="Войти" Height="35" Background="#007BFF" Foreground="WhiteSmoke" BorderThickness="0" Margin="0,0,0,15" Click="Войти"/>

            <TextBlock x:Name="NoAccountText" Text="Нет аккаунта?" HorizontalAlignment="Center" Foreground="Gray"/>

            <!-- Кнопка Зарегистрироваться -->
            <Button x:Name="RegisterBtn" Content="Зарегистрироваться" Background="WhiteSmoke" Foreground="#007BFF" BorderThickness="0" Margin="0,5,0,0" Click="Регистрация"/>
        </StackPanel>
    </Grid>
</Window>