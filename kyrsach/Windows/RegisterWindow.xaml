<Window x:Class="kyrsach.Windows.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="WhiteSmoke"
        FontFamily="Bahnschrift">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Создание аккаунта" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логин или телефон" FontSize="12" Margin="0 0 0 5"/>
            <TextBox x:Name="txtPhone" Height="30" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" FontSize="12" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" Padding="5" Margin="0,0,0,15"/>

            <TextBlock Text="Адрес доставки:" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="txtAddress" Height="30" Padding="5" Margin="0,0,0,20"/>

            <Button Content="Зарегистрироваться" Height="35" Background="#007BFF" Foreground="White" BorderThickness="0" Click="Register_Click" Cursor="Hand"/>
            <Button Content="Отмена" Height="30" Background="Transparent" Foreground="Gray" BorderThickness="0" Margin="0,10,0,0" Click="Cancel_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>