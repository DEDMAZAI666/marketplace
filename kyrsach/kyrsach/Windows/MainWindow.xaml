<Window x:Class="kyrsach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kyrsach"
        mc:Ignorable="d"
        Height="800" Width="1400"
        MinWidth="1100"
        MinHeight="700"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Bahnschrift"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        >
    <Border Background="WhiteSmoke">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="WhiteSmoke">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="1" VerticalAlignment="Bottom" Background="Black"/>
                <Border Grid.Column="1" Height="1" VerticalAlignment="Bottom" Background="Black"/>
                <Border Grid.Column="2" Height="1" VerticalAlignment="Bottom" Background="Black"/>

                <StackPanel Margin="20 0 0 0" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock FontSize="20" VerticalAlignment="Center" Foreground="Black" Text="Электронный Магазин"/>
                </StackPanel>
                <StackPanel Margin="0 0 7 0" Grid.Column="2" Orientation="Horizontal">
                    <Button Click="MinWindow_Click" Content="-"/>
                    <Button Click="MaxWindow_Click" Content="[]"/>
                    <Button Click="CloseWindow_Click" Content="x"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="WhiteSmoke" BorderBrush="Black" BorderThickness="0 0 1 0">
                    <StackPanel Margin="0 10 0 0">
                        <Border Height="1" Margin="15 5 15 10" Background="Black"/>
                        <TextBlock Text="Фильтры" HorizontalAlignment="Center"/>
                        <Border Height="1" Margin="15 5 15 10" Background="Black"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>

</Window>

