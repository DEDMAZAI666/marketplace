<Page x:Class="kyrsach.Pages.Tovar"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Tovar">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#FAFAFA">
        <ItemsControl x:Name="ProductsList" Margin="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- Карточка товара -->
                    <Border Width="220" Height="330" Background="White" Margin="10" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Картинка -->
                            <Image Source="{Binding ImageUrl}" Stretch="Uniform" Margin="10"/>

                            <!-- Информация о товаре -->
                            <StackPanel Grid.Row="1" Margin="10">

                                <!-- Название и Сердечко (Избранное) -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <!-- Кнопка избранного (добавлено событие Loaded) -->
                                    <Button Grid.Column="1" 
                                            Content="&#xE734;" 
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="16"
                                            Background="Transparent" 
                                            Foreground="#CCCCCC" 
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Padding="5,0"
                                            Click="AddToFavorites_Click" 
                                            CommandParameter="{Binding}"
                                            Loaded="FavoriteButton_Loaded"/>
                                </Grid>

                                <!-- Категория -->
                                <TextBlock Text="{Binding Category}" Foreground="Gray" FontSize="12"/>

                                <!-- Цена -->
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" FontWeight="Bold" Foreground="#0078D7" FontSize="18" Margin="0,5,0,0"/>

                                <!-- Кнопка в корзину -->
                                <Button Content="В корзину" 
                                        Background="#E3F2FD" Foreground="#0078D7" BorderThickness="0"
                                        Padding="10,5" FontWeight="SemiBold" Cursor="Hand"
                                        Margin="0,8,0,0"
                                        Click="AddToCart_Click" CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#0078D7"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Page>