<Page x:Class="kyrsach.Pages.MyProducts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мои товары"
      Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Мои товары" FontSize="24" FontWeight="Bold" Foreground="#2D3436"/>
            <TextBlock Text="Здесь вы можете редактировать или удалять добавленные вами товары." 
                       FontSize="13" Foreground="#636E72" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="15" ShadowDepth="1" Direction="270"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MyProductsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFBFC" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="70" Height="70" CornerRadius="6" Background="#EDEFF2" VerticalAlignment="Center">
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436"/>
                                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#636E72" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" FontSize="14" FontWeight="SemiBold" Foreground="#6C5CE7" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}" FontSize="11" Foreground="Gray" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- КНОПКИ РЕДАКТИРОВАНИЯ И УДАЛЕНИЯ (будут только у товаров юзера) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✎ Редактировать" Background="#FDCB6E" Foreground="#2D3436" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" Click="Edit_Click" Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="🗑 Удалить" Background="#FF7675" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand" Click="Delete_Click" Tag="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>