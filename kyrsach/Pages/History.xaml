<Page x:Class="kyrsach.Pages.History"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="История заказов"
      Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Мои заказы" FontSize="24" FontWeight="Bold" Foreground="#2D3436"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="OrdersList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="1" Direction="270"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Id, StringFormat='Заказ №{0}'}" 
                                                   FontSize="16" FontWeight="Bold" Foreground="#2D3436"/>
                                        <TextBlock Text="{Binding OrderDate, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}" 
                                                   FontSize="12" Foreground="#636E72" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding TotalPrice, StringFormat='{}{0:N0} ₽'}" 
                                               FontSize="16" FontWeight="Bold" Foreground="#6C5CE7" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#EDEFF2" Margin="0,0,0,10"/>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="13" Foreground="#2D3436" Margin="0,0,0,4">
                                                • <Run Text="{Binding ProductName}" FontWeight="SemiBold"/> 
                                                (Кол-во: <Run Text="{Binding Quantity}"/>) — 
                                                <Run Text="{Binding PriceAtPurchase, StringFormat='{}{0:N0} ₽'}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>