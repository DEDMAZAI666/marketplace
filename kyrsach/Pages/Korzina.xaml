<Page x:Class="kyrsach.Pages.Korzina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Korzina"
      Background="#FAFAFA">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- КНОПКА НАЗАД -->
        <Button Grid.Row="0" 
                Content="← Вернуться в каталог" 
                Background="Transparent" 
                Foreground="#0078D7" 
                BorderThickness="0" 
                FontSize="16" 
                FontWeight="SemiBold"
                Cursor="Hand" 
                HorizontalAlignment="Left" 
                Margin="0,0,0,15"
                Click="GoBack_Click"/>

        <!-- Заголовок -->
        <TextBlock Grid.Row="1" Text="Корзина" FontSize="28" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,20"/>

        <!-- Список товаров в корзине -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="CartItemsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Margin="0,0,0,10" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Source="{Binding ImageUrl}" Width="80" Height="80" Stretch="Uniform"/>

                                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding Category}" Foreground="Gray" FontSize="14"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N0} ₽}" FontWeight="Bold" FontSize="18" Foreground="#0078D7" HorizontalAlignment="Right"/>
                                    <Button Content="Удалить" 
                                            Background="Transparent" 
                                            Foreground="#E81123" 
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,5,0,0"
                                            Click="RemoveFromCart_Click" 
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Итоговая сумма и кнопка оформления -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5" Padding="20" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TotalText" Text="Итого: 0 ₽" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Оформить заказ" 
                        Background="#0078D7" Foreground="White" BorderThickness="0"
                        Padding="20,10" FontSize="16" FontWeight="SemiBold" Cursor="Hand"
                        Click="Checkout_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#005A9E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Page>